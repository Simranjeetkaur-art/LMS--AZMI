{{!
    @template mod_flashdeck/manage_cards

    Teacher card list with add, edit, delete and reorder actions.

    Example context (json):
    {
        "hascards": true,
        "cardcount": 1,
        "cards": [
            {"cardid": 3, "position": 1, "typename": "Basic (two-sided)",
             "summary": "What does -itis mean?", "tags": "emd101,week1",
             "editurl": "#", "deleteurl": "#", "upurl": "#", "downurl": "#",
             "isfirst": true, "islast": true}
        ],
        "addbuttons": [
            {"url": "#", "name": "Basic (two-sided)"}
        ],
        "seedurl": "#",
        "viewurl": "#"
    }
}}
<div class="flashdeck-manage">
    <div class="flashdeck-addbar">
        <span class="flashdeck-addlabel">{{#str}} addcard, mod_flashdeck {{/str}}:</span>
        {{#addbuttons}}
        <a class="btn btn-primary" href="{{url}}">{{name}}</a>
        {{/addbuttons}}
    </div>
    <div class="flashdeck-addbar">
        <a class="btn btn-outline-secondary" href="{{importurl}}">{{#str}} importcards, mod_flashdeck {{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{exportjsonurl}}">{{#str}} exportjson, mod_flashdeck {{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{exportcsvurl}}">{{#str}} exportcsv, mod_flashdeck {{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{copyurl}}">{{#str}} copycards, mod_flashdeck {{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{seedurl}}">{{#str}} loadsampledeck, mod_flashdeck {{/str}}</a>
    </div>

    {{^hascards}}
        <p class="flashdeck-empty">{{#str}} nocards, mod_flashdeck {{/str}}</p>
    {{/hascards}}

    {{#hascards}}
    <table class="generaltable flashdeck-cardtable">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">{{#str}} cardtype, mod_flashdeck {{/str}}</th>
                <th scope="col">{{#str}} cardsummary, mod_flashdeck {{/str}}</th>
                <th scope="col">{{#str}} cardtags, mod_flashdeck {{/str}}</th>
                <th scope="col">{{#str}} actions, core {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#cards}}
            <tr>
                <td>{{position}}</td>
                <td>{{typename}}</td>
                <td>{{summary}}</td>
                <td>{{tags}}</td>
                <td class="flashdeck-actions">
                    {{^isfirst}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{upurl}}">{{#str}} moveup, core {{/str}}</a>
                    {{/isfirst}}
                    {{^islast}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{downurl}}">{{#str}} movedown, core {{/str}}</a>
                    {{/islast}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{editurl}}">{{#str}} edit, core {{/str}}</a>
                    <a class="btn btn-sm btn-outline-danger" href="{{deleteurl}}">{{#str}} delete, core {{/str}}</a>
                </td>
            </tr>
            {{/cards}}
        </tbody>
    </table>
    {{/hascards}}

    <div class="flashdeck-managelink">
        <a class="btn btn-outline-secondary" href="{{viewurl}}">{{#str}} view, core {{/str}}</a>
    </div>
</div>
