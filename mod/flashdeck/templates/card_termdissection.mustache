{{!
    @template mod_flashdeck/card_termdissection

    Term dissection card: front shows the whole term; the back reveals
    the term split into colour-coded word parts (prefix / root / link /
    suffix), each captioned with its role and meaning, plus the full
    definition. Part colours come from theme CSS variables.

    Example context (json):
    {
        "term": "cardiology",
        "definition": "The medical specialty devoted to the study of the heart.",
        "parts": [
            {"text": "cardi", "role": "root", "rolename": "Root", "meaning": "heart"},
            {"text": "o", "role": "link", "rolename": "Link", "meaning": "combining vowel"},
            {"text": "logy", "role": "suffix", "rolename": "Suffix", "meaning": "study of"}
        ]
    }
}}
<div class="flashdeck-face flashdeck-face-front">
    <div class="flashdeck-face-body">
        <p class="flashdeck-term">{{term}}</p>
        <p class="flashdeck-prompthint">{{#str}} dissectprompt, mod_flashdeck {{/str}}</p>
    </div>
</div>
<details class="flashdeck-face flashdeck-face-back">
    <summary class="flashdeck-reveal">{{#str}} showanswer, mod_flashdeck {{/str}}</summary>
    <div class="flashdeck-face-body">
        <p class="flashdeck-dissection">
            {{#parts}}
            <span class="flashdeck-part flashdeck-role-{{role}}">
                <span class="flashdeck-parttext">{{text}}</span>
                <span class="flashdeck-partcaption">{{rolename}}{{#meaning}} · {{meaning}}{{/meaning}}</span>
            </span>
            {{/parts}}
        </p>
        <p class="flashdeck-definition">{{definition}}</p>
    </div>
</details>
