{{!
    @template mod_flashdeck/card_cloze

    Cloze / type-the-answer card. Blanks are native text inputs, so the
    attempt works without JavaScript; the Check button (JS only) marks
    each blank with light normalisation. Accepted answers ride along in
    a data attribute — flashcards are self-assessment, the answer is on
    the back anyway.

    Example context (json):
    {
        "casesensitive": 0,
        "frontsegments": [
            {"isblank": false, "text": "The powerhouse of the cell is the "},
            {"isblank": true, "blankno": 1, "answersjson": "[\"mitochondrion\"]", "size": 14},
            {"isblank": false, "text": "."}
        ],
        "backsegments": [
            {"isblank": false, "text": "The powerhouse of the cell is the "},
            {"isblank": true, "text": "mitochondrion", "alternatives": "mitochondria"},
            {"isblank": false, "text": "."}
        ]
    }
}}
<div class="flashdeck-face flashdeck-face-front">
    <div class="flashdeck-face-body">
        <p class="flashdeck-clozetext" data-casesensitive="{{casesensitive}}">
            {{#frontsegments}}
                {{^isblank}}{{text}}{{/isblank}}
                {{#isblank}}<input type="text" class="flashdeck-blank" size="{{size}}"
                    data-answers="{{answersjson}}" data-casesensitive="{{casesensitive}}"
                    aria-label="{{#str}} blanknumber, mod_flashdeck, {{blankno}} {{/str}}"
                    autocapitalize="off" autocomplete="off" spellcheck="false">{{/isblank}}
            {{/frontsegments}}
        </p>
        <p class="flashdeck-jsonly">
            <button type="button" class="btn btn-secondary btn-sm" data-action="checkanswers">
                {{#str}} checkanswers, mod_flashdeck {{/str}}
            </button>
            <span class="flashdeck-checkfeedback" data-region="checkfeedback" aria-live="polite"></span>
        </p>
    </div>
</div>
<details class="flashdeck-face flashdeck-face-back">
    <summary class="flashdeck-reveal">{{#str}} showanswer, mod_flashdeck {{/str}}</summary>
    <div class="flashdeck-face-body">
        <p class="flashdeck-clozetext">
            {{#backsegments}}
                {{^isblank}}{{text}}{{/isblank}}
                {{#isblank}}<mark class="flashdeck-clozeanswer">{{text}}</mark>{{#alternatives}}
                    <span class="flashdeck-alternatives">({{#str}} alsoaccepted, mod_flashdeck, {{.}} {{/str}})</span>
                {{/alternatives}}{{/isblank}}
            {{/backsegments}}
        </p>
    </div>
</details>
