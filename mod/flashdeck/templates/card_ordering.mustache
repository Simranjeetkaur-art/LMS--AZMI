{{!
    @template mod_flashdeck/card_ordering

    Ordering card: steps shown alphabetically, learner assigns each a
    position via a native select (accessible, no-JS-friendly); Check
    (JS) marks each. The back shows the correct numbered sequence.

    Example context (json):
    {
        "prompt": "Order the stages of mitosis",
        "scrambled": [
            {"text": "Anaphase", "answer": 3,
             "positions": [{"value": 1, "label": 1}, {"value": 2, "label": 2}]}
        ],
        "ordered": ["Prophase", "Metaphase", "Anaphase", "Telophase"]
    }
}}
<div class="flashdeck-face flashdeck-face-front">
    <div class="flashdeck-face-body">
        <p class="flashdeck-prompt">{{prompt}}</p>
        <div class="flashdeck-matchrows">
            {{#scrambled}}
            <label class="flashdeck-matchrow">
                <select class="flashdeck-orderselect" data-answer="{{answer}}"
                        aria-label="{{#str}} positionfor, mod_flashdeck, {{text}} {{/str}}">
                    <option value="">{{#str}} choosedots, core {{/str}}</option>
                    {{#positions}}
                    <option value="{{value}}">{{label}}</option>
                    {{/positions}}
                </select>
                <span class="flashdeck-matchleft">{{text}}</span>
            </label>
            {{/scrambled}}
        </div>
        <p class="flashdeck-jsonly">
            <button type="button" class="btn btn-secondary btn-sm" data-action="checkanswers">
                {{#str}} checkanswers, mod_flashdeck {{/str}}
            </button>
            <span class="flashdeck-checkfeedback" data-region="checkfeedback" aria-live="polite"></span>
        </p>
    </div>
</div>
<details class="flashdeck-face flashdeck-face-back">
    <summary class="flashdeck-reveal">{{#str}} showanswer, mod_flashdeck {{/str}}</summary>
    <div class="flashdeck-face-body">
        <p class="flashdeck-prompt">{{#str}} correctorder, mod_flashdeck {{/str}}</p>
        <ol class="flashdeck-orderedlist">
            {{#ordered}}
            <li>{{.}}</li>
            {{/ordered}}
        </ol>
    </div>
</details>
