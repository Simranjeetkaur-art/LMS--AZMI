{{!
    @template mod_flashdeck/card_matching

    Matching card: native selects keep the attempt accessible and
    working without JavaScript; Check (JS) marks each row.

    Example context (json):
    {
        "prompt": "Match each prefix to its meaning",
        "rows": [
            {"left": "brady-", "answer": 0,
             "options": [{"value": 1, "label": "fast"}, {"value": 0, "label": "slow"}]}
        ],
        "pairs": [
            {"left": "brady-", "right": "slow"},
            {"left": "tachy-", "right": "fast"}
        ]
    }
}}
<div class="flashdeck-face flashdeck-face-front">
    <div class="flashdeck-face-body">
        <p class="flashdeck-prompt">{{prompt}}</p>
        <div class="flashdeck-matchrows">
            {{#rows}}
            <label class="flashdeck-matchrow">
                <span class="flashdeck-matchleft">{{left}}</span>
                <select class="flashdeck-matchselect" data-answer="{{answer}}">
                    <option value="">{{#str}} choosedots, core {{/str}}</option>
                    {{#options}}
                    <option value="{{value}}">{{label}}</option>
                    {{/options}}
                </select>
            </label>
            {{/rows}}
        </div>
        <p class="flashdeck-jsonly">
            <button type="button" class="btn btn-secondary btn-sm" data-action="checkanswers">
                {{#str}} checkanswers, mod_flashdeck {{/str}}
            </button>
            <span class="flashdeck-checkfeedback" data-region="checkfeedback" aria-live="polite"></span>
        </p>
    </div>
</div>
<details class="flashdeck-face flashdeck-face-back">
    <summary class="flashdeck-reveal">{{#str}} showanswer, mod_flashdeck {{/str}}</summary>
    <div class="flashdeck-face-body">
        <dl class="flashdeck-matchanswers">
            {{#pairs}}
            <div class="flashdeck-matchpair">
                <dt>{{left}}</dt>
                <dd>{{right}}</dd>
            </div>
            {{/pairs}}
        </dl>
    </div>
</details>
