{{!
    @template mod_flashdeck/card_qanda

    Q&A (open recall) card: free-form prompt, model answer and optional
    marking guidance to support an honest self-grade.

    Example context (json):
    {
        "fronthtml": "<p>Why is spaced repetition more effective than massed review?</p>",
        "backhtml": "<p>Retrieval at increasing intervals strengthens retention…</p>",
        "guidance": "A strong answer mentions the spacing effect and active recall."
    }
}}
<div class="flashdeck-face flashdeck-face-front">
    <div class="flashdeck-face-body">
        {{{fronthtml}}}
    </div>
</div>
<details class="flashdeck-face flashdeck-face-back">
    <summary class="flashdeck-reveal">{{#str}} showanswer, mod_flashdeck {{/str}}</summary>
    <div class="flashdeck-face-body">
        {{{backhtml}}}
        {{#guidance}}
        <p class="flashdeck-guidance">{{guidance}}</p>
        {{/guidance}}
        <p class="flashdeck-prompthint">{{#str}} selfgradehint, mod_flashdeck {{/str}}</p>
    </div>
</details>
