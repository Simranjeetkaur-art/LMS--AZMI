{{!
    @template local_contentchecker/layout_tabbedcomparison

    Tabbed panels, suited to comparison tables such as drug classes or
    differentials. Uses Bootstrap's tab roles so keyboard and screen-reader
    users get real tab semantics rather than styled links.

    Context variables required for this template:
    * intro - HTML shown above the tabs
    * tabs - array of { tabid, title, body, active }

    Example context (json):
    {
        "intro": "<p>Compare the two drug classes.</p>",
        "tabs": [
            {"tabid": "cct-0", "title": "Beta blockers", "body": "<p>...</p>", "active": true},
            {"tabid": "cct-1", "title": "ACE inhibitors", "body": "<p>...</p>", "active": false}
        ]
    }
}}
<div class="cct-layout cct-layout-tabbedcomparison">
    {{#intro}}<div class="cct-layout-intro">{{{intro}}}</div>{{/intro}}
    <ul class="nav nav-tabs mt-3" role="tablist">
        {{#tabs}}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{#active}}active{{/active}}"
                   id="{{tabid}}-tab"
                   data-toggle="tab"
                   href="#{{tabid}}"
                   role="tab"
                   aria-controls="{{tabid}}"
                   aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{title}}</a>
            </li>
        {{/tabs}}
    </ul>
    <div class="tab-content border border-top-0 p-3">
        {{#tabs}}
            <div class="tab-pane fade {{#active}}show active{{/active}}"
                 id="{{tabid}}"
                 role="tabpanel"
                 aria-labelledby="{{tabid}}-tab">
                {{{body}}}
            </div>
        {{/tabs}}
    </div>
</div>
