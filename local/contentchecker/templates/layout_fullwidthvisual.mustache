{{!
    @template local_contentchecker/layout_fullwidthvisual

    A dominant diagram or 3D model with a condensed sidebar summary. The
    sidebar follows the body in source order so it is read last, which is the
    right order for a summary even though it is displayed alongside.

    Context variables required for this template:
    * media - HTML for the dominant visual
    * body - HTML for the supporting prose
    * sidebar - HTML for the condensed summary

    Example context (json):
    {
        "media": "<img src='thorax.png' alt='Thorax'>",
        "body": "<p>The thoracic cavity contains...</p>",
        "sidebar": "<ul><li>Three compartments</li></ul>"
    }
}}
<div class="cct-layout cct-layout-fullwidthvisual">
    <div class="cct-layout-media mb-3">
        {{{media}}}
    </div>
    <div class="row">
        <div class="col-12 col-lg-8 cct-layout-body">
            {{{body}}}
        </div>
        <aside class="col-12 col-lg-4 cct-layout-sidebar">
            <div class="card">
                <div class="card-body">
                    {{{sidebar}}}
                </div>
            </div>
        </aside>
    </div>
</div>
