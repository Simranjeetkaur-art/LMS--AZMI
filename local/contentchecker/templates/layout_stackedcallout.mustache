{{!
    @template local_contentchecker/layout_stackedcallout

    Full-width prose with pull-out callouts. Each callout is an <aside> so a
    screen reader announces it as set apart from the surrounding text rather
    than reading it as an interruption mid-paragraph.

    Context variables required for this template:
    * body - HTML for the main prose
    * callouts - array of { title, body }

    Example context (json):
    {
        "body": "<p>Beta blockers reduce heart rate.</p>",
        "callouts": [
            {"title": "Clinical note", "body": "<p>Avoid in asthma.</p>"}
        ]
    }
}}
<div class="cct-layout cct-layout-stackedcallout">
    <div class="cct-layout-body">
        {{{body}}}
    </div>
    {{#callouts}}
        <aside class="cct-callout alert alert-info my-3">
            {{#title}}<h4 class="h6 cct-callout-title">{{title}}</h4>{{/title}}
            <div class="cct-callout-body">{{{body}}}</div>
        </aside>
    {{/callouts}}
</div>
